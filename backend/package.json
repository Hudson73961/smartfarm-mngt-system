{
  "name": "sfms-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch ./src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --experimental-strip-types --test ./test/format.test.mjs",
    "db:up": "docker compose -f ../docker-compose.yml up -d db",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:reset": "docker compose -f ../docker-compose.yml down -v && docker compose -f ../docker-compose.yml up -d db",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev --name init",
    "prisma:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "seed": "tsx ./prisma/seed.ts",
    "seed:admin": "tsx ./prisma/seed-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "csv-stringify": "^6.9.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "prisma": "^6.16.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
