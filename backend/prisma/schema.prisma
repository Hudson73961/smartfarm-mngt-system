generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FARMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CropStatus {
  PLANNED
  ACTIVE
  HARVESTED
  ARCHIVED
}

enum LivestockStatus {
  ACTIVE
  SICK
  SOLD
  DECEASED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum NotificationKind {
  INFO
  ALERT
  SUCCESS
  WARNING
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  CONFLICT
}

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique
  passwordHash       String
  phone              String?
  location           String?
  role               UserRole         @default(FARMER)
  status             UserStatus      @default(ACTIVE)
  preferredUnits     String          @default("kg")
  lastLoginAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  farms              Farm[]
  tasks              Task[]
  notifications     Notification[]
  auditLogs          AuditLog[]
  resetTokens        PasswordReset[]
  syncEvents         SyncQueue[]
  expenses           Expense[]
  incomes            Income[]
}

model Farm {
  id               String         @id @default(cuid())
  name             String
  location         String
  sizeHa           Decimal?       @db.Decimal(10, 2)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  crops            Crop[]
  livestock        Livestock[]
  tasks            Task[]
  activities       Activity[]
  expenses         Expense[]
  incomes          Income[]
  harvests         Harvest[]
  notifications    Notification[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
}

model Crop {
  id                   String      @id @default(cuid())
  farmId               String
  farm                 Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name                 String
  variety              String?
  plotId               String?
  plantingDate         DateTime?
  fieldSize            Decimal?    @db.Decimal(10, 2)
  fieldUnit            String      @default("acres")
  seedQuantity         Decimal?    @db.Decimal(10, 2)
  fertilizerUsage      String?
  pesticideUsage       String?
  irrigationActivities String?
  expectedHarvestDate   DateTime?
  actualHarvestDate    DateTime?
  harvestQuantity      Decimal?    @db.Decimal(10, 2)
  harvestUnit          String?
  status               CropStatus  @default(PLANNED)
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  harvests             Harvest[]
  expenses             Expense[]
  incomes              Income[]

  @@index([farmId, status])
}

model Livestock {
  id                   String          @id @default(cuid())
  farmId               String
  farm                 Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  type                 String
  breed                String?
  tagNumber            String?
  quantity             Int             @default(1)
  acquisitionDate       DateTime?
  dateOfBirth          DateTime?
  feedingRecords       String?
  healthRecords        String?
  vaccinationRecords   String?
  breedingRecords      String?
  productionRecords    String?
  mortalityRecords     String?
  status               LivestockStatus @default(ACTIVE)
  notes                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  expenses             Expense[]
  incomes              Income[]

  @@index([farmId, status])
}

model Activity {
  id             String    @id @default(cuid())
  farmId         String
  farm           Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           String
  activityDate   DateTime  @default(now())
  status         String    @default("planned")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tasks          Task[]

  @@index([farmId, activityDate])
}

model Task {
  id          String      @id @default(cuid())
  farmId      String
  farm        Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String?
  activity    Activity?   @relation(fields: [activityId], references: [id], onDelete: SetNull)
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([farmId, status, dueDate])
}

model Expense {
  id            String    @id @default(cuid())
  farmId        String
  farm          Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String
  amount        Decimal   @db.Decimal(12, 2)
  date          DateTime  @default(now())
  description   String?
  paymentMethod String?
  receiptRef    String?
  cropId        String?
  crop          Crop?     @relation(fields: [cropId], references: [id], onDelete: SetNull)
  livestockId   String?
  livestock     Livestock? @relation(fields: [livestockId], references: [id], onDelete: SetNull)
  activityId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([farmId, date])
}

model Income {
  id            String    @id @default(cuid())
  farmId        String
  farm          Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source        String
  product       String?
  quantity      Decimal?  @db.Decimal(12, 2)
  unitPrice     Decimal?  @db.Decimal(12, 2)
  totalAmount   Decimal   @db.Decimal(12, 2)
  date          DateTime  @default(now())
  buyerRef      String?
  cropId        String?
  crop          Crop?     @relation(fields: [cropId], references: [id], onDelete: SetNull)
  livestockId   String?
  livestock     Livestock? @relation(fields: [livestockId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([farmId, date])
}

model Harvest {
  id         String   @id @default(cuid())
  farmId     String
  farm       Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId     String
  crop       Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  quantity   Decimal  @db.Decimal(12, 2)
  unit       String   @default("kg")
  quality    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([farmId, date])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmId    String?
  farm      Farm?            @relation(fields: [farmId], references: [id], onDelete: SetNull)
  title     String
  message   String
  kind      NotificationKind @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole   UserRole?
  action      String
  entityType  String?
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
}

model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SyncQueue {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableName   String
  operation   String
  payload     Json
  clientId    String?
  status      SyncStatus @default(PENDING)
  retries     Int        @default(0)
  lastError   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, status, createdAt])
}
